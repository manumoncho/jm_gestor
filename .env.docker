# Configuración de Permisos (UID/GID del usuario del host)
UID=1000
GID=1000

# Configuración de la Base de Datos para Docker
DB_HOST=db
DB_PORT=3306
DB_NAME=sistemadeventas
DB_USER=sistema_user
DB_PASS=sistema_pass

# Configuración de la Aplicación
APP_URL=http://localhost:8081
APP_PORT=8081
APP_TIMEZONE=America/La_Paz
APP_VERSION=1.16.6
APP_DEBUG=false
SESSION_LIFETIME=60
REMEMBER_LIFETIME=14

# Moneda mostrada en vistas, PDFs y reportes
APP_CURRENCY_SYMBOL=Bs.

# Configuración de Mail (Opcional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Sistema de Ventas"
